     "strong": "Сильный день",
 }
 
+MOMENTUM_RISING_THRESHOLD = 5.0
+MOMENTUM_FALLING_THRESHOLD = -5.0
+
+
+def _compute_momentum(
+    today_support: float,
+    history: list[dict[str, float]],
+) -> tuple[Literal["rising", "flat", "falling", "insufficient"], float | None]:
+    # START_FUNCTION_CONTRACT: F-M-DAY-RELATIVE-STATUS._compute_momentum
+    # purpose: Compute support momentum by comparing the recent window
+    #   (today_support + history[0].support) with the previous window
+    #   (history[1].support + history[2].support). Classification uses the
+    #   unrounded difference; only the reported delta is rounded.
+    # inputs: today_support (float), history (list[dict] with "support" keys, history[0] is yesterday).
+    # returns: (momentum Literal, momentum_delta float rounded to 2 dp or None).
+    # side_effects: none (pure calculation).
+    # emitted_logs: none.
+    # error_behavior: Returns ("insufficient", None) when history has fewer than 3 entries.
+    # END_FUNCTION_CONTRACT: F-M-DAY-RELATIVE-STATUS._compute_momentum
+    if len(history) < 3:
+        return "insufficient", None
+
+    recent_window = (today_support + history[0]["support"]) / 2.0
+    previous_window = (history[1]["support"] + history[2]["support"]) / 2.0
+    delta = recent_window - previous_window
+
+    if delta >= MOMENTUM_RISING_THRESHOLD:
+        momentum: Literal["rising", "flat", "falling", "insufficient"] = "rising"
+    elif delta <= MOMENTUM_FALLING_THRESHOLD:
+        momentum = "falling"
+    else:
+        momentum = "flat"
+
+    return momentum, round(delta, 2)
+
 
