+# START_BLOCK: MOMENTUM_TESTS
+def _day(support: float) -> dict[str, float]:
+    return {"support": support, "tension": 20.0}
+
+
+def test_momentum_rising_falling_flat():
+    """Momentum classifies rising/falling/flat from recent vs previous support windows."""
+    # recent = (100 + 100)/2 = 100, previous = (50 + 50)/2 = 50, delta = +50
+    history_rising = [_day(100.0)] + [_day(50.0)] * 6
+    res_rising = compute_relative_status(100.0, 30.0, "steady", history_rising)
+    assert res_rising.momentum == "rising"
+    assert res_rising.momentum_delta == 50.0
+
+    # recent = (0 + 0)/2 = 0, previous = (50 + 50)/2 = 50, delta = -50
+    history_falling = [_day(0.0)] + [_day(50.0)] * 6
+    res_falling = compute_relative_status(0.0, 30.0, "steady", history_falling)
+    assert res_falling.momentum == "falling"
+    assert res_falling.momentum_delta == -50.0
+
+    # recent = 50, previous = 50, delta = 0
+    history_flat = [_day(50.0)] * 7
+    res_flat = compute_relative_status(50.0, 30.0, "steady", history_flat)
+    assert res_flat.momentum == "flat"
+    assert res_flat.momentum_delta == 0.0
+
+
+def test_momentum_insufficient_short_history():
+    """Fewer than 3 history entries yields insufficient momentum and a null delta."""
+    res_0 = compute_relative_status(100.0, 30.0, "steady", [])
+    assert res_0.momentum == "insufficient"
+    assert res_0.momentum_delta is None
+
+    res_2 = compute_relative_status(100.0, 30.0, "steady", [_day(100.0), _day(50.0)])
+    assert res_2.momentum == "insufficient"
+    assert res_2.momentum_delta is None
+
+
+def test_momentum_boundary_plus_five():
+    """Exactly +5.0 raw difference classifies as rising (boundary is inclusive)."""
+    history = [_day(100.0), _day(95.0), _day(95.0)] + [_day(95.0)] * 4
+    res = compute_relative_status(100.0, 30.0, "steady", history)
+    assert res.momentum == "rising"
+    assert res.momentum_delta == 5.0
+
+
+def test_momentum_boundary_minus_five():
+    """Exactly -5.0 raw difference classifies as falling (boundary is inclusive)."""
+    history = [_day(90.0), _day(95.0), _day(95.0)] + [_day(95.0)] * 4
+    res = compute_relative_status(90.0, 30.0, "steady", history)
+    assert res.momentum == "falling"
+    assert res.momentum_delta == -5.0
+
+
+def test_momentum_just_inside_flat():
+    """A raw difference of +4.99 stays flat (just inside the threshold)."""
+    history = [_day(100.0), _day(95.01), _day(95.01)] + [_day(95.01)] * 4
+    res = compute_relative_status(100.0, 30.0, "steady", history)
+    assert res.momentum == "flat"
+    assert res.momentum_delta == 4.99
+
+
+def test_momentum_classification_ignores_rounding():
+    """Classification uses the unrounded difference: raw +5.004 is rising, delta reported as 5.0."""
+    # recent = (100.008 + 100)/2 = 100.004, previous = (95 + 95)/2 = 95, delta = 5.004
+    history = [_day(100.0), _day(95.0), _day(95.0)] + [_day(95.0)] * 4
+    res = compute_relative_status(100.008, 30.0, "steady", history)
+    assert res.momentum == "rising"
+    assert res.momentum_delta == 5.0
+
+
+def test_momentum_absolute_mode():
+    """Momentum is computed identically in absolute (cold start) mode with 3-4 days of history."""
+    history_3 = [_day(100.0), _day(50.0), _day(50.0)]
+    res_3 = compute_relative_status(100.0, 30.0, "steady", history_3)
+    assert res_3.mode == "absolute"
+    assert res_3.momentum == "rising"
+    assert res_3.momentum_delta == 50.0
+
+    history_4 = history_3 + [_day(50.0)]
+    res_4 = compute_relative_status(100.0, 30.0, "steady", history_4)
+    assert res_4.mode == "absolute"
+    assert res_4.momentum == "rising"
+    assert res_4.momentum_delta == 50.0
+
+    res_2 = compute_relative_status(100.0, 30.0, "steady", history_3[:2])
+    assert res_2.mode == "absolute"
+    assert res_2.momentum == "insufficient"
+    assert res_2.momentum_delta is None
+
+
+def test_momentum_camelcase_wire_contract():
+    """Momentum serializes to the wire contract as momentum and momentumDelta."""
+    history = [_day(100.0), _day(50.0), _day(50.0)] + [_day(50.0)] * 4
+    res = compute_relative_status(100.0, 30.0, "steady", history)
+    dumped = res.model_dump(by_alias=True)
+    assert dumped["momentum"] == "rising"
+    assert dumped["momentumDelta"] == 50.0
+
+    res_short = compute_relative_status(100.0, 30.0, "steady", [_day(50.0)])
+    dumped_short = res_short.model_dump(by_alias=True)
+    assert dumped_short["momentum"] == "insufficient"
+    assert dumped_short["momentumDelta"] is None
+# END_BLOCK: MOMENTUM_TESTS
