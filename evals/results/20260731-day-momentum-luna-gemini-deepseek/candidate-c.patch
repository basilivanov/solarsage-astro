+def test_support_momentum_categories_and_boundaries():
+    """Verify rising, falling, flat, exact +/-5.0 boundaries, and just-inside +4.99."""
+    # history[0]=yesterday, history[1]=day before, history[2]=day before that
+    # previous_window = (50.0 + 50.0) / 2 = 50.0
+
+    # 1. Exact boundary +5.0 -> rising (recent = (60.0 + 50.0) / 2 = 55.0; 55.0 - 50.0 = +5.0)
+    history_base = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+    ]
+    res_rising_bound = compute_relative_status(60.0, 20.0, "steady", history_base)
+    assert res_rising_bound.momentum == "rising"
+    assert res_rising_bound.momentum_delta == 5.0
+
+    # 2. Just inside +4.99 -> flat (today = 59.98, recent = (59.98 + 50.0) / 2 = 54.99; diff = 4.99)
+    res_flat_inside = compute_relative_status(59.98, 20.0, "steady", history_base)
+    assert res_flat_inside.momentum == "flat"
+    assert res_flat_inside.momentum_delta == 4.99
+
+    # 3. Exact boundary -5.0 -> falling (today = 40.0, recent = (40.0 + 50.0) / 2 = 45.0; 45.0 - 50.0 = -5.0)
+    res_falling_bound = compute_relative_status(40.0, 20.0, "steady", history_base)
+    assert res_falling_bound.momentum == "falling"
+    assert res_falling_bound.momentum_delta == -5.0
+
+    # 4. Standard flat (today = 52.0, recent = 51.0; diff = 1.0)
+    res_flat = compute_relative_status(52.0, 20.0, "steady", history_base)
+    assert res_flat.momentum == "flat"
+    assert res_flat.momentum_delta == 1.0
+
+
+def test_support_momentum_classification_unrounded():
+    """Classification uses raw unrounded diff (e.g. raw 5.004 -> rising, reported delta -> 5.0)."""
+    history_base = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+    ]
+    # today = 60.008 -> recent mean = (60.008 + 50.0) / 2 = 55.004.
+    # raw diff = 5.004 >= 5.0 -> rising.
+    # rounded delta = 5.00.
+    res = compute_relative_status(60.008, 20.0, "steady", history_base)
+    assert res.momentum == "rising"
+    assert res.momentum_delta == 5.0
+
+
+def test_support_momentum_insufficient_history():
+    """Fewer than 3 history items yields momentum='insufficient' and momentum_delta=None."""
+    for count in range(3):
+        history = [{"support": 50.0, "tension": 20.0}] * count
+        res = compute_relative_status(60.0, 20.0, "steady", history)
+        assert res.momentum == "insufficient"
+        assert res.momentum_delta is None
+
+
+def test_support_momentum_in_absolute_mode():
+    """Momentum is computed identically when mode is 'absolute' (history len 3 or 4)."""
+    # 3 days history -> mode="absolute", but momentum calculated from history[0..2]
+    history3 = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+    ]
+    res3 = compute_relative_status(60.0, 20.0, "steady", history3)
+    assert res3.mode == "absolute"
+    assert res3.momentum == "rising"
+    assert res3.momentum_delta == 5.0
+
+    # 4 days history -> mode="absolute"
+    history4 = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+    ]
+    res4 = compute_relative_status(40.0, 20.0, "steady", history4)
+    assert res4.mode == "absolute"
+    assert res4.momentum == "falling"
+    assert res4.momentum_delta == -5.0
