+def test_momentum_insufficient_for_short_history():
+    """Fewer than 3 historical days cannot form both support windows."""
+    history = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+    ]
+
+    res = compute_relative_status(60.0, 20.0, "steady", history)
+
+    assert res.momentum == "insufficient"
+    assert res.momentum_delta is None
+
+
+@pytest.mark.parametrize(
+    ("today_support", "history", "expected_momentum", "expected_delta"),
+    [
+        (
+            70.0,
+            [
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+            ],
+            "rising",
+            10.0,
+        ),
+        (
+            30.0,
+            [
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+            ],
+            "falling",
+            -10.0,
+        ),
+        (
+            50.0,
+            [
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+                {"support": 50.0, "tension": 20.0},
+            ],
+            "flat",
+            0.0,
+        ),
+    ],
+)
+def test_momentum_direction_and_scale(
+    today_support, history, expected_momentum, expected_delta
+):
+    """Support momentum uses the two required two-day means on the 0..100 scale."""
+    res = compute_relative_status(today_support, 20.0, "steady", history)
+
+    assert res.momentum == expected_momentum
+    assert res.momentum_delta == expected_delta
+    assert res.model_dump(by_alias=True)["momentumDelta"] == expected_delta
+
+
+@pytest.mark.parametrize(
+    ("today_support", "expected_momentum", "expected_delta"),
+    [
+        (60.0, "rising", 5.0),
+        (40.0, "falling", -5.0),
+        (59.98, "flat", 4.99),
+    ],
+)
+def test_momentum_thresholds_and_unrounded_classification(
+    today_support, expected_momentum, expected_delta
+):
+    """Thresholds include exactly +/-5, while a +5.004 raw delta stays rising after rounding."""
+    history = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+        {"support": 50.0, "tension": 20.0},
+    ]
+
+    res = compute_relative_status(today_support, 20.0, "steady", history)
+
+    assert res.momentum == expected_momentum
+    assert res.momentum_delta == expected_delta
+
+    unrounded = compute_relative_status(60.008, 20.0, "steady", history)
+    assert unrounded.momentum == "rising"
+    assert unrounded.momentum_delta == 5.0
+
+
+def test_momentum_is_consistent_in_absolute_and_relative_modes():
+    """The same first three history entries produce the same momentum in both modes."""
+    absolute_history = [
+        {"support": 50.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+    ]
+    relative_history = absolute_history + [
+        {"support": 40.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+        {"support": 40.0, "tension": 20.0},
+    ]
+
+    absolute = compute_relative_status(60.0, 20.0, "steady", absolute_history)
+    relative = compute_relative_status(60.0, 20.0, "steady", relative_history)
+
+    assert absolute.mode == "absolute"
+    assert relative.mode == "relative"
+    assert absolute.momentum == relative.momentum == "rising"
+    assert absolute.momentum_delta == relative.momentum_delta == 15.0
