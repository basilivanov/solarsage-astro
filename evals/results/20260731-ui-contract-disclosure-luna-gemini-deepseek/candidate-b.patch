+// ############################################################################
+// AI_HEADER: MODULE_TESTS_CHECKIN_STATISTICS
+// ROLE: Verify the Profile check-in statistics UI semantic contract and methodology disclosure.
+// ############################################################################
+
+// START_MODULE_CONTRACT: M-TESTS-CHECKIN-STATISTICS
+// purpose: Verify loading, error, ready, empty, and methodology disclosure behavior of CheckinStatistics.
+// owns:
+//   - __tests__/components/CheckinStatistics.test.tsx
+// inputs: Mocked check-in metrics API responses.
+// outputs: Vitest DOM contract assertions.
+// dependencies: @testing-library/react, vitest, components/profile/checkin-statistics.
+// side_effects: none.
+// emitted_logs: none.
+// invariants:
+//   - Root state attributes and required accessibility semantics are asserted through public DOM selectors.
+//   - Methodology facts are static Russian copy and the disclosure is closed initially.
+// failure_policy: Test failures are surfaced by Vitest.
+// END_MODULE_CONTRACT: M-TESTS-CHECKIN-STATISTICS
+
+// START_MODULE_MAP: M-TESTS-CHECKIN-STATISTICS
+// public_entrypoints:
+//   - CheckinStatistics component test suite
+// semantic_blocks:
+//   - ROOT_STATES: loading, error, ready, and empty rendering contract
+//   - METHODOLOGY_DISCLOSURE: toggle, region linkage, visibility, and static facts
+// owned_tests:
+//   - components/profile/checkin-statistics.tsx
+// END_MODULE_MAP: M-TESTS-CHECKIN-STATISTICS
+
+import { fireEvent, render, screen, waitFor } from "@testing-library/react"
+import { beforeEach, describe, expect, it, vi } from "vitest"
+
+vi.mock("@/lib/api/checkin", () => ({
+  formatDateInTimeZone: vi.fn(() => "2026-07-31"),
+  getCheckinMetrics: vi.fn(),
+}))
+
+import { CheckinStatistics } from "@/components/profile/checkin-statistics"
+import { getCheckinMetrics } from "@/lib/api/checkin"
+
+const metrics = {
+  totalCheckins: 12,
+  currentStreak: 3,
+  longestStreak: 7,
+  averageMood: 3.8,
+  averageEnergy: 3.4,
+  averageAccuracy: 2.9,
+  moodDistribution: { "1": 1, "2": 2, "3": 3, "4": 4, "5": 2 },
+  accuracyDistribution: {},
+  tagFrequency: { спокойствие: 4 },
+}
+
+describe("CheckinStatistics", () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it("exposes the loading root state with the existing status semantics", () => {
+    vi.mocked(getCheckinMetrics).mockImplementation(
+      () => new Promise(() => {}),
+    )
+
+    render(<CheckinStatistics />)
+
+    const root = screen.getByTestId("profile-checkin-statistics")
+    expect(root.getAttribute("data-state")).toBe("loading")
+    expect(root.getAttribute("role")).toBe("status")
+    expect(root.getAttribute("aria-busy")).toBe("true")
+  })
+
+  it("exposes the error root state while preserving the alert message", async () => {
+    vi.mocked(getCheckinMetrics).mockRejectedValue(new Error("Metrics unavailable"))
+
+    render(<CheckinStatistics />)
+
+    const alert = await screen.findByRole("alert")
+    const root = screen.getByTestId("profile-checkin-statistics")
+    expect(root.getAttribute("data-state")).toBe("error")
+    expect(alert.textContent).toContain("Metrics unavailable")
+  })
+
+  it("exposes the ready root state and renders the collapsed methodology disclosure", async () => {
+    vi.mocked(getCheckinMetrics).mockResolvedValue(metrics)
+
+    render(<CheckinStatistics />)
+
+    const toggle = await screen.findByRole("button", {
+      name: "Как считается статистика",
+    })
+    const root = screen.getByTestId("profile-checkin-statistics")
+    const region = screen.getByTestId("checkin-stats-methodology")
+
+    expect(root.getAttribute("data-state")).toBe("ready")
+    expect(toggle.getAttribute("data-testid")).toBe(
+      "checkin-stats-methodology-toggle",
+    )
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(toggle.getAttribute("aria-controls")).toBe(
+      "checkin-stats-methodology",
+    )
+    expect(document.getElementById(toggle.getAttribute("aria-controls") ?? "")).toBe(
+      region,
+    )
+    expect(region.getAttribute("id")).toBe("checkin-stats-methodology")
+    expect(region.hidden).toBe(true)
+  })
+
+  it("toggles the methodology region and exposes all static methodology facts", async () => {
+    vi.mocked(getCheckinMetrics).mockResolvedValue(metrics)
+
+    render(<CheckinStatistics />)
+
+    const toggle = await screen.findByRole("button", {
+      name: "Как считается статистика",
+    })
+    const region = screen.getByTestId("checkin-stats-methodology")
+
+    fireEvent.click(toggle)
+
+    await waitFor(() => {
+      expect(toggle.getAttribute("aria-expanded")).toBe("true")
+      expect(region.hidden).toBe(false)
+    })
+    expect(region.textContent).toContain("30 дней")
+    expect(region.textContent).toContain("шкале 1–5")
+    expect(region.textContent).toContain("последовательные дни")
+
+    fireEvent.click(toggle)
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(region.hidden).toBe(true)
+  })
+
+  it("keeps the empty metrics state unrendered", async () => {
+    vi.mocked(getCheckinMetrics).mockResolvedValue({
+      ...metrics,
+      totalCheckins: 0,
+    })
+
+    render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(screen.queryByTestId("profile-checkin-statistics")).toBeNull()
+    })
+  })
+})
