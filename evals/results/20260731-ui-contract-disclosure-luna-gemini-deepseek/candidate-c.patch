+import { fireEvent, render, screen, waitFor } from "@testing-library/react"
+import { beforeEach, describe, expect, it, vi } from "vitest"
+import type { CheckinMetrics } from "@/packages/contracts"
+
+const { getCheckinMetrics, formatDateInTimeZone } = vi.hoisted(() => ({
+  getCheckinMetrics: vi.fn(),
+  formatDateInTimeZone: vi.fn(() => "2026-07-31"),
+}))
+
+vi.mock("@/lib/api/checkin", () => ({
+  getCheckinMetrics,
+  formatDateInTimeZone,
+}))
+
+import { CheckinStatistics } from "@/components/profile/checkin-statistics"
+
+const metrics: CheckinMetrics = {
+  totalCheckins: 21,
+  currentStreak: 5,
+  longestStreak: 12,
+  averageMood: 3.4,
+  averageEnergy: 3.1,
+  averageAccuracy: 2.2,
+  moodDistribution: { "3": 5, "4": 6 },
+  accuracyDistribution: {},
+  tagFrequency: { "Спорт": 3 },
+}
+
+describe("CheckinStatistics", () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  it("loading state exposes root testid with data-state=loading, role=status and aria-busy", () => {
+    getCheckinMetrics.mockReturnValue(new Promise(() => {}))
+    render(<CheckinStatistics />)
+
+    const section = screen.getByTestId("profile-checkin-statistics")
+    expect(section.getAttribute("data-state")).toBe("loading")
+    expect(section.getAttribute("role")).toBe("status")
+    expect(section.getAttribute("aria-busy")).toBe("true")
+  })
+
+  it("error state exposes root testid with data-state=error and keeps role=alert", async () => {
+    getCheckinMetrics.mockRejectedValue(new Error("network down"))
+    render(<CheckinStatistics />)
+
+    const section = screen.getByTestId("profile-checkin-statistics")
+    await waitFor(() => {
+      expect(section.getAttribute("data-state")).toBe("error")
+    })
+    expect(section.getAttribute("role")).toBeNull()
+    const message = section.querySelector('[role="alert"]')
+    expect(message).not.toBeNull()
+  })
+
+  it("ready state exposes root testid with data-state=ready", async () => {
+    getCheckinMetrics.mockResolvedValue(metrics)
+    render(<CheckinStatistics />)
+
+    const section = screen.getByTestId("profile-checkin-statistics")
+    await waitFor(() => {
+      expect(section.getAttribute("data-state")).toBe("ready")
+    })
+  })
+
+  it("methodology toggle is collapsed by default with aria-controls on an existing region", async () => {
+    getCheckinMetrics.mockResolvedValue(metrics)
+    render(<CheckinStatistics />)
+
+    const toggle = await screen.findByTestId("checkin-stats-methodology-toggle")
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(toggle.getAttribute("aria-controls")).toBe(
+      "checkin-stats-methodology",
+    )
+
+    const region = screen.getByTestId("checkin-stats-methodology")
+    expect(region.getAttribute("id")).toBe("checkin-stats-methodology")
+    expect(region.hasAttribute("hidden")).toBe(true)
+  })
+
+  it("toggling updates aria-expanded and reveals the region", async () => {
+    getCheckinMetrics.mockResolvedValue(metrics)
+    render(<CheckinStatistics />)
+
+    const toggle = await screen.findByTestId("checkin-stats-methodology-toggle")
+    fireEvent.click(toggle)
+
+    expect(toggle.getAttribute("aria-expanded")).toBe("true")
+    const region = screen.getByTestId("checkin-stats-methodology")
+    expect(region.hasAttribute("hidden")).toBe(false)
+
+    fireEvent.click(toggle)
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(screen.getByTestId("checkin-stats-methodology").hasAttribute("hidden")).toBe(true)
+  })
+
+  it("contains the three static methodology facts", async () => {
+    getCheckinMetrics.mockResolvedValue(metrics)
+    render(<CheckinStatistics />)
+
+    const toggle = await screen.findByTestId("checkin-stats-methodology-toggle")
+    fireEvent.click(toggle)
+
+    expect(screen.getByText(/за последние 30 дней/)).toBeDefined()
+    expect(screen.getByText(/от 1 до 5/)).toBeDefined()
+    expect(screen.getByText(/дней подряд/)).toBeDefined()
+  })
+})
