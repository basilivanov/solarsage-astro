+import { describe, expect, it, vi } from "vitest"
+import { fireEvent, render, screen } from "@testing-library/react"
+import { getCheckinMetrics } from "@/lib/api/checkin"
+import { CheckinStatistics } from "@/components/profile/checkin-statistics"
+import type { CheckinMetrics } from "@/packages/contracts"
+
+vi.mock("@/lib/api/checkin", () => ({
+  formatDateInTimeZone: vi.fn(() => "2026-07-31"),
+  getCheckinMetrics: vi.fn(),
+}))
+
+const mockMetrics: CheckinMetrics = {
+  totalCheckins: 10,
+  currentStreak: 3,
+  longestStreak: 5,
+  averageMood: 4.2,
+  moodDistribution: {
+    "1": 0,
+    "2": 1,
+    "3": 2,
+    "4": 4,
+    "5": 3,
+  },
+  tagFrequency: {
+    "спорт": 5,
+    "работа": 3,
+  },
+  lastCheckinDate: "2026-07-31",
+}
+
+describe("CheckinStatistics contract", () => {
+  it("renders root element with data-state='loading' during initial fetch", () => {
+    vi.mocked(getCheckinMetrics).mockReturnValue(new Promise(() => {}))
+
+    render(<CheckinStatistics />)
+
+    const section = screen.getByTestId("profile-checkin-statistics")
+    expect(section).toBeTruthy()
+    expect(section.getAttribute("data-state")).toBe("loading")
+    expect(section.getAttribute("role")).toBe("status")
+    expect(section.getAttribute("aria-busy")).toBe("true")
+  })
+
+  it("renders root element with data-state='error' on fetch failure", async () => {
+    vi.mocked(getCheckinMetrics).mockRejectedValue(new Error("API failure"))
+
+    render(<CheckinStatistics />)
+
+    const section = await screen.findByTestId("profile-checkin-statistics")
+    expect(section.getAttribute("data-state")).toBe("error")
+    expect(screen.getByRole("alert")).toBeTruthy()
+    expect(screen.getByRole("alert").textContent).toContain("API failure")
+  })
+
+  it("renders root element with data-state='ready' and methodology disclosure behavior", async () => {
+    vi.mocked(getCheckinMetrics).mockResolvedValue(mockMetrics)
+
+    render(<CheckinStatistics />)
+
+    const section = await screen.findByTestId("profile-checkin-statistics")
+    expect(section.getAttribute("data-state")).toBe("ready")
+
+    const toggle = screen.getByTestId("checkin-stats-methodology-toggle")
+    expect(toggle).toBeTruthy()
+    expect(toggle.getAttribute("type")).toBe("button")
+    expect(toggle.textContent).toContain("Как считается статистика")
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(toggle.getAttribute("aria-controls")).toBe("checkin-stats-methodology")
+
+    // Region hidden by default
+    expect(screen.queryByTestId("checkin-stats-methodology")).toBeNull()
+
+    // Toggle opens disclosure
+    fireEvent.click(toggle)
+
+    expect(toggle.getAttribute("aria-expanded")).toBe("true")
+    const region = screen.getByTestId("checkin-stats-methodology")
+    expect(region).toBeTruthy()
+    expect(region.id).toBe("checkin-stats-methodology")
+
+    // 3 static methodology facts
+    expect(region.textContent).toContain("30-дневный")
+    expect(region.textContent).toContain("от 1 до 5")
+    expect(region.textContent).toContain("подряд")
+
+    // Toggle closes disclosure
+    fireEvent.click(toggle)
+    expect(toggle.getAttribute("aria-expanded")).toBe("false")
+    expect(screen.queryByTestId("checkin-stats-methodology")).toBeNull()
+  })
+
+  it("renders nothing when totalCheckins === 0", async () => {
+    vi.mocked(getCheckinMetrics).mockResolvedValue({
+      ...mockMetrics,
+      totalCheckins: 0,
+    })
+
+    render(<CheckinStatistics />)
+
+    // After resolution, loading finishes and empty metrics returns null
+    await screen.findByTestId("profile-checkin-statistics") // Wait for fetch resolution to finish, but section should disappear
+  })
+})
