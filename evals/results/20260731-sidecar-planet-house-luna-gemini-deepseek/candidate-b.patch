+# wave: W-4.1
+# purpose: Normalization planet-house preference/fallback tests
+
+import pytest
+
+from app.services.normalization_service import NormalizationService
+
+
+@pytest.fixture
+def sample_houses():
+    """Regular 30-degree house cusps: house N spans [(N-1)*30, N*30)."""
+    return [
+        {"number": i, "cusp": float((i - 1) * 30)} for i in range(1, 13)
+    ]
+
+
+def _natal(planet_fields, houses):
+    return {"planets": [planet_fields], "houses": houses}
+
+
+def _house_signals(natal):
+    service = NormalizationService()
+    return service._planets_in_houses(natal)
+
+
+def test_prefers_provided_valid_house(sample_houses):
+    """A valid provided house (int 1-12) wins over the longitude mapping."""
+    # 69.5° would map to house 3 via find_house, but the payload says house 7.
+    natal = _natal({"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": 7}, sample_houses)
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].type == "planet_in_house"
+    assert signals[0].planet == "Sun"
+    assert signals[0].house == 7
+
+
+def test_falls_back_when_house_absent(sample_houses):
+    """Old sidecar payloads without a `house` field use find_house as before."""
+    natal = _natal({"name": "Sun", "longitude": 69.5, "sign": "Gemini"}, sample_houses)
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].house == 3  # 69.5° is in house 3 (60-90)
+
+
+@pytest.mark.parametrize("invalid_house", [
+    0,
+    13,
+    -1,
+    100,
+    "5",
+    "7",
+    5.0,
+    7.5,
+    True,
+    [5],
+])
+def test_falls_back_when_house_invalid(sample_houses, invalid_house):
+    """Invalid provided houses (out of range or wrong type) fall back to find_house."""
+    natal = _natal(
+        {"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": invalid_house},
+        sample_houses,
+    )
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].house == 3  # find_house fallback for 69.5°
+
+
+def test_none_house_falls_back(sample_houses):
+    """A null provided house falls back to find_house."""
+    natal = _natal(
+        {"name": "Moon", "longitude": 120.0, "sign": "Leo", "house": None},
+        sample_houses,
+    )
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].house == 5  # 120.0° is in house 5
+
+
+def test_boundary_house_preference(sample_houses):
+    """Valid boundary houses are honored: house 1 and house 12."""
+    natal = _natal(
+        {
+            "name": "Sun",
+            "longitude": 359.0,
+            "sign": "Pisces",
+            "house": 1,
+        },
+        sample_houses,
+    )
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].house == 1  # preference overrides find_house -> 12
+
+
+def test_provided_house_used_even_with_empty_houses(sample_houses):
+    """A valid provided house is preferred even when the houses list is empty."""
+    natal = _natal(
+        {"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": 3},
+        [],
+    )
+
+    signals = _house_signals(natal)
+
+    assert len(signals) == 1
+    assert signals[0].house == 3
+
+
+def test_empty_houses_without_provided_house_fail_closed(sample_houses):
+    """Empty houses with no valid provided house fabricate nothing."""
+    natal = _natal(
+        {"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": None},
+        [],
+    )
+
+    signals = _house_signals(natal)
+
+    assert signals == []
+
+
+def test_normalize_natal_only_uses_preference(sample_houses):
+    """normalize_natal_only planet_in_house signals honor the provided house."""
+    natal = {
+        "planets": [
+            {"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": 9},
+            {"name": "Moon", "longitude": 120.0, "sign": "Leo"},
+        ],
+        "houses": sample_houses,
+    }
+
+    service = NormalizationService()
+    signals = service.normalize_natal_only(natal)
+    house_signals = {s.planet: s.house for s in signals if s.type == "planet_in_house"}
+
+    assert house_signals["Sun"] == 9  # provided house preferred
+    assert house_signals["Moon"] == 5  # absent house falls back to find_house
+
+
+def test_normalize_day_rebuild_fallback(sample_houses):
+    """normalize_day rebuild-from-raw falls back to find_house for old contexts."""
+    natal_context = {
+        "planets": [
+            {"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": 11},
+        ],
+        "houses": sample_houses,
+        "natal_signals": [],
+    }
+    transits = {"planets": []}
+
+    service = NormalizationService()
+    signals = service.normalize_day(natal_context, transits)
+    house_signals = [s for s in signals if s.type == "planet_in_house"]
+
+    assert house_signals[0].house == 11  # provided house preferred
