+# module: M-SIDECAR-TEST-PLANET-HOUSE
+# wave: W-3.2
+# purpose: Natal planet house tests
+
+import pytest
+
+pytestmark = pytest.mark.usefixtures("moshier_mode")
+from datetime import datetime
+
+from httpx import AsyncClient, ASGITransport
+
+from solarsage.app import app
+from solarsage.models.chart import NatalChart, find_house
+from solarsage.services.calculation_core import calculate_natal_response
+from solarsage.services.natal import NatalService
+
+MOSCOW = {
+    "birth_date": "1990-01-15",
+    "birth_time": "14:30",
+    "birth_lat": 55.7558,
+    "birth_lon": 37.6173,
+    "birth_tz": "Europe/Moscow",
+}
+
+MURMANSK = {
+    "birth_date": "1980-10-30",
+    "birth_time": "19:50",
+    "birth_lat": 67.9387,  # Murmansk (high latitude) -> WHOLE_SIGN
+    "birth_lon": 32.9241,
+    "birth_tz": "Europe/Moscow",
+}
+
+# Houses whose 12th cusp wraps around 0/360 (350° -> 10°) so the 12th/1st
+# house interval crosses the 360° boundary.
+WRAPAROUND_HOUSES = [
+    {"number": 1, "cusp": 10.0},
+    {"number": 2, "cusp": 40.0},
+    {"number": 3, "cusp": 70.0},
+    {"number": 4, "cusp": 100.0},
+    {"number": 5, "cusp": 130.0},
+    {"number": 6, "cusp": 160.0},
+    {"number": 7, "cusp": 190.0},
+    {"number": 8, "cusp": 220.0},
+    {"number": 9, "cusp": 250.0},
+    {"number": 10, "cusp": 280.0},
+    {"number": 11, "cusp": 310.0},
+    {"number": 12, "cusp": 350.0},
+]
+
+
+@pytest.mark.asyncio
+async def test_natal_endpoint_planets_carry_house():
+    """Every planet in the natal response carries a valid house field."""
+    transport = ASGITransport(app=app)
+    async with AsyncClient(transport=transport, base_url="http://test") as client:
+        response = await client.post("/v1/natal", json=MOSCOW)
+
+        assert response.status_code == 200
+        data = response.json()
+
+        assert len(data["planets"]) == 10
+        for planet in data["planets"]:
+            assert "house" in planet, f"planet {planet['name']} missing house"
+            assert planet["house"] is None or 1 <= planet["house"] <= 12
+
+
+@pytest.mark.asyncio
+async def test_natal_planets_house_matches_cusp_intervals():
+    """Each planet's house equals the house whose cusp interval contains its longitude."""
+    transport = ASGITransport(app=app)
+    async with AsyncClient(transport=transport, base_url="http://test") as client:
+        response = await client.post("/v1/natal", json=MOSCOW)
+        assert response.status_code == 200
+        data = response.json()
+
+        for planet in data["planets"]:
+            expected = find_house(planet["longitude"], data["houses"])
+            assert planet["house"] == expected, (
+                f"{planet['name']} at {planet['longitude']}° expected house {expected}, got {planet['house']}"
+            )
+
+
+@pytest.mark.asyncio
+async def test_both_house_systems_produce_correct_house_values():
+    """PLACIDUS (normal latitude) and WHOLE_SIGN (high latitude) both emit valid houses."""
+    transport = ASGITransport(app=app)
+    async with AsyncClient(transport=transport, base_url="http://test") as client:
+        for payload in (MOSCOW, MURMANSK):
+            response = await client.post("/v1/natal", json=payload)
+            assert response.status_code == 200
+            data = response.json()
+            assert data["house_system"] in ("PLACIDUS", "WHOLE_SIGN")
+
+            for planet in data["planets"]:
+                expected = find_house(planet["longitude"], data["houses"])
+                assert planet["house"] == expected, (
+                    f"{data['house_system']}: {planet['name']} at {planet['longitude']}° "
+                    f"expected house {expected}, got {planet['house']}"
+                )
+
+
+def test_calculate_natal_response_planets_carry_house():
+    """The direct natal calculation path also emits a house on every planet."""
+    response = calculate_natal_response(**MOSCOW)
+    for planet in response.planets:
+        assert planet.house is not None
+        assert 1 <= planet.house <= 12
+
+
+def test_find_house_basic_intervals():
+    """find_house matches lower-inclusive / upper-exclusive cusp intervals."""
+    houses = [{"number": i, "cusp": float(30 * (i - 1))} for i in range(1, 13)]
+
+    assert find_house(5.0, houses) == 1
+    assert find_house(29.9, houses) == 1
+    assert find_house(30.0, houses) == 2
+    assert find_house(89.0, houses) == 3
+    assert find_house(120.0, houses) == 5
+    assert find_house(359.0, houses) == 12
+
+
+def test_find_house_wraparound():
+    """Longitudes near 0/360 resolve into the 12th/1st house wraparound interval."""
+    assert find_house(355.0, WRAPAROUND_HOUSES) == 12
+    assert find_house(5.0, WRAPAROUND_HOUSES) == 12
+    assert find_house(10.0, WRAPAROUND_HOUSES) == 1
+    assert find_house(39.0, WRAPAROUND_HOUSES) == 1
+    assert find_house(40.0, WRAPAROUND_HOUSES) == 2
+    assert find_house(345.0, WRAPAROUND_HOUSES) == 11
+
+
+def test_find_house_empty_houses():
+    """Empty houses resolve to None, never to a fabricated house number."""
+    assert find_house(123.0, []) is None
+
+
+def test_assign_planet_houses_wraparound():
+    """NatalChart.assign_planet_houses uses the wraparound semantics end-to-end."""
+    chart = NatalChart(
+        birth_datetime=datetime(1990, 1, 15, 14, 30),
+        latitude=55.7558,
+        longitude=37.6173,
+        positions=[
+            {"name": "Sun", "longitude": 355.0, "latitude": 0.0, "speed": 1.0, "sign": "Pisces", "retrograde": False},
+            {"name": "Moon", "longitude": 5.0, "latitude": 0.0, "speed": 13.0, "sign": "Aries", "retrograde": False},
+            {"name": "Mercury", "longitude": 10.0, "latitude": 0.0, "speed": 1.0, "sign": "Aries", "retrograde": False},
+        ],
+        houses=WRAPAROUND_HOUSES,
+        special_points=[],
+        house_system="PLACIDUS",
+    )
+
+    chart.assign_planet_houses()
+    by_name = {p["name"]: p["house"] for p in chart.positions}
+
+    assert by_name["Sun"] == 12  # 355° lies in the wrapped 12th house
+    assert by_name["Moon"] == 12  # 5° lies before the 1st-house cusp at 10°
+    assert by_name["Mercury"] == 1  # 10° is the 1st-house cusp (lower inclusive)
+
+
+def test_natal_service_assigns_planet_houses():
+    """NatalService.calculate_natal_chart already carries a house on every position."""
+    chart = NatalService().calculate_natal_chart(
+        date_str=MOSCOW["birth_date"],
+        time_str=MOSCOW["birth_time"],
+        tz_str=MOSCOW["birth_tz"],
+        latitude=MOSCOW["birth_lat"],
+        longitude=MOSCOW["birth_lon"],
+    )
+    assert len(chart.positions) == 10
+    for pos in chart.positions:
+        assert "house" in pos
+        assert pos["house"] is None or 1 <= pos["house"] <= 12
+        assert pos["house"] == find_house(pos["longitude"], chart.houses)
