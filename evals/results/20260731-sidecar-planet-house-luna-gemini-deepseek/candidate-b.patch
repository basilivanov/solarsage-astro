 from typing import Dict, List, Any
 
 
+def find_house(longitude: float, houses: List[Dict[str, Any]]) -> int | None:
+    # START_FUNCTION_CONTRACT: F-M-SOLARSAGE-CHART-MODELS.find_house
+    # purpose: Find which natal house a longitude falls into.
+    # inputs: longitude (float), houses (list of dicts with number and cusp).
+    # returns: int (house number 1-12) or None if houses list is empty.
+    # side_effects: none (pure function).
+    # emitted_logs: none.
+    # error_behavior: returns None on empty input; never raises.
+    # END_FUNCTION_CONTRACT: F-M-SOLARSAGE-CHART-MODELS.find_house
+    """Find which natal house a longitude falls into.
+
+    Houses may be in any order — sorts by cusp ascending before lookup.
+    Handles wrap-around (e.g., a house spanning 350°→10°). Semantics mirror
+    the API's M-ASTRO-UTILS.find_house so both sides agree on every planet.
+
+    Returns None if houses list is empty, otherwise always returns a house number.
+    """
+    if not houses:
+        return None
+
+    def _house_cusp(house: Dict[str, Any]) -> float:
+        raw = house.get("cusp", house.get("longitude", 0))
+        return float(raw or 0)
+
+    sorted_houses = sorted(houses, key=_house_cusp)
+
+    for i, h in enumerate(sorted_houses):
+        next_h = sorted_houses[(i + 1) % len(sorted_houses)]
+        cusp = _house_cusp(h)
+        next_cusp = _house_cusp(next_h)
+
+        if next_cusp > cusp:
+            if cusp <= longitude < next_cusp:
+                return int(h["number"])
+        else:  # wraparound: e.g., house starts at 350°, ends at 10°
+            if longitude >= cusp or longitude < next_cusp:
+                return int(h["number"])
+
+    # Fallback: should not reach here, but return first house
+    return int(sorted_houses[0]["number"])
+
+
