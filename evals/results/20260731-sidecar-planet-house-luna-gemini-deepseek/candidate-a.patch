+# START_BLOCK: PLANET_HOUSE_ASSIGNMENT
+def _find_house(longitude: float, houses: list[dict[str, Any]]) -> int | None:
+    # START_FUNCTION_CONTRACT: F-M-SOLARSAGE-NATAL-SERVICE._find_house
+    # purpose: Find the house containing one natal planet longitude.
+    # inputs: longitude in degrees; houses with number and cusp fields.
+    # returns: House number 1-12, or None when no houses are available.
+    # side_effects: none (pure computation).
+    # emitted_logs: none.
+    # error_behavior: returns None for an empty house list; otherwise mirrors
+    #   API cusp interval fallback and returns its first-house fallback.
+    # END_FUNCTION_CONTRACT: F-M-SOLARSAGE-NATAL-SERVICE._find_house
+    """Find a house using the API's sorted-cusp interval semantics."""
+    if not houses:
+        return None
+
+    def _house_cusp(house: dict[str, Any]) -> float:
+        raw = house.get("cusp", house.get("longitude", 0))
+        return float(raw or 0)
+
+    sorted_houses = sorted(houses, key=_house_cusp)
+
+    for index, house in enumerate(sorted_houses):
+        next_house = sorted_houses[(index + 1) % len(sorted_houses)]
+        cusp = _house_cusp(house)
+        next_cusp = _house_cusp(next_house)
+
+        if next_cusp > cusp:
+            if cusp <= longitude < next_cusp:
+                return int(house["number"])
+        else:
+            # The final sorted cusp owns the interval that wraps through 0°.
+            if longitude >= cusp or longitude < next_cusp:
+                return int(house["number"])
+
+    # The API fallback is defensive for malformed/degenerate cusp lists.
+    return int(sorted_houses[0]["number"])
