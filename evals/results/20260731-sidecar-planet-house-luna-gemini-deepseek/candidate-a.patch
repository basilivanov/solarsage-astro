@@ -0,0 +1,85 @@
+# ############################################################################
+# AI_HEADER: TEST_NORMALIZATION_PLANET_HOUSE — sidecar house preference tests.
+# ROLE: Verify natal normalization consumes the new sidecar house field while
+#       preserving the old longitude/cusp fallback.
+# ############################################################################
+
+# START_MODULE_CONTRACT: M-TEST-NORMALIZATION-PLANET-HOUSE
+# purpose: Test valid, absent, and invalid natal planet house inputs.
+# owns:
+#   - apps/api/tests/test_normalization_planet_house.py
+# inputs: Synthetic natal payloads representing new and old sidecars.
+# outputs: Assertions over AstroSignal house assignments.
+# dependencies: M-NORMALIZATION-SERVICE.
+# side_effects: none.
+# emitted_logs: none.
+# invariants:
+#   - Valid integer house values 1-12 win over longitude mapping.
+#   - Missing or invalid values use find_house exactly as before.
+# failure_policy: pytest assertion failure.
+# END_MODULE_CONTRACT: M-TEST-NORMALIZATION-PLANET-HOUSE
+
+# START_MODULE_MAP: M-TEST-NORMALIZATION-PLANET-HOUSE
+# public_entrypoints: none
+# semantic_blocks:
+#   - HOUSE_PREFERENCE: valid sidecar field wins.
+#   - HOUSE_FALLBACK: old and invalid payloads use cusp mapping.
+# owned_tests:
+#   - apps/api/tests/test_normalization_planet_house.py
+# END_MODULE_MAP: M-TEST-NORMALIZATION-PLANET-HOUSE
+
+from __future__ import annotations
+
+import pytest
+
+from app.services.normalization_service import NormalizationService
+
+
+_HOUSES = [
+    {"number": number, "cusp": float((number - 1) * 30)}
+    for number in range(1, 13)
+]
+
+
+def _natal(planet: dict[str, object]) -> dict[str, object]:
+    return {"planets": [planet], "houses": _HOUSES}
+
+
+# START_BLOCK: HOUSE_PREFERENCE
+def test_valid_provided_house_is_preferred_over_longitude_mapping():
+    """A valid sidecar house remains authoritative for natal normalization."""
+    signals = NormalizationService()._planets_in_houses(
+        _natal({"name": "Sun", "longitude": 69.5, "sign": "Gemini", "house": 12})
+    )
+
+    assert len(signals) == 1
+    assert signals[0].house == 12
+# END_BLOCK: HOUSE_PREFERENCE
+
+
+# START_BLOCK: HOUSE_FALLBACK
+def test_absent_house_uses_legacy_longitude_mapping():
+    """Old sidecar payloads without house keep their previous result."""
+    signals = NormalizationService()._planets_in_houses(
+        _natal({"name": "Sun", "longitude": 69.5, "sign": "Gemini"})
+    )
+
+    assert len(signals) == 1
+    assert signals[0].house == 3
+
+
+@pytest.mark.parametrize("invalid_house", [0, 13, "3", 3.0, True])
+def test_invalid_house_uses_legacy_longitude_mapping(invalid_house):
+    """Out-of-range and wrong-type sidecar values fall back safely."""
+    signals = NormalizationService()._planets_in_houses(
+        _natal({
+            "name": "Sun",
+            "longitude": 69.5,
+            "sign": "Gemini",
+            "house": invalid_house,
+        })
+    )
+
+    assert len(signals) == 1
+    assert signals[0].house == 3
+# END_BLOCK: HOUSE_FALLBACK
