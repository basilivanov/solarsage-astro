+// ############################################################################
+// AI_HEADER: MODULE_TESTS_CHECKIN_STATISTICS — event and rendering contract
+// ROLE: Prove Profile check-in statistics observability and unchanged state rendering.
+// DEPENDENCIES: vitest, @testing-library/react, components/profile/checkin-statistics
+// GRACE_ANCHORS: [CHECKIN_STATISTICS_TESTS]
+// SLICE: SLICE-PROFILE-ONBOARDING
+// ############################################################################
+
+// START_MODULE_CONTRACT: M-TESTS-COMPONENTS-CHECKIN-STATISTICS
+// purpose: Verify aggregate check-in metrics logging and existing success, error, and empty rendering behavior.
+// owns:
+//   - __tests__/components/CheckinStatistics.test.tsx
+// inputs: mocked getCheckinMetrics and logEvent calls
+// outputs: Vitest assertions
+// dependencies:
+//   - M-COMPONENTS-CHECKIN-STATISTICS (CheckinStatistics)
+//   - M-OBSERVABILITY-EVENTS (checkin.metrics_viewed)
+// side_effects: none (test harness)
+// emitted_logs: none
+// invariants:
+//   - successful non-empty loads emit one aggregate payload with no personal data
+//   - errors and empty metrics do not emit checkin.metrics_viewed
+// failure_policy: assertion failure on contract violation
+// END_MODULE_CONTRACT: M-TESTS-COMPONENTS-CHECKIN-STATISTICS
+
+// START_MODULE_MAP: M-TESTS-COMPONENTS-CHECKIN-STATISTICS
+// public_entrypoints:
+//   - none (test suite)
+// semantic_blocks:
+//   - SUCCESS_EVENT: successful non-empty load event and rendered content
+//   - ERROR_EVENT: failed fetch does not emit the business event
+//   - EMPTY_EVENT: empty metrics do not emit the business event
+// owned_tests:
+//   - __tests__/components/CheckinStatistics.test.tsx
+// END_MODULE_MAP: M-TESTS-COMPONENTS-CHECKIN-STATISTICS
+
+import { render, screen, waitFor } from "@testing-library/react"
+import { beforeEach, describe, expect, it, vi } from "vitest"
+
+const {
+  mockFormatDateInTimeZone,
+  mockGetCheckinMetrics,
+  mockLogEvent,
+} = vi.hoisted(() => ({
+  mockFormatDateInTimeZone: vi.fn(),
+  mockGetCheckinMetrics: vi.fn(),
+  mockLogEvent: vi.fn(),
+}))
+
+vi.mock("@/lib/api/checkin", () => ({
+  formatDateInTimeZone: mockFormatDateInTimeZone,
+  getCheckinMetrics: mockGetCheckinMetrics,
+}))
+
+vi.mock("@/lib/log", () => ({
+  logEvent: mockLogEvent,
+}))
+
+import { CheckinStatistics } from "@/components/profile/checkin-statistics"
+
+const metrics = {
+  totalCheckins: 7,
+  currentStreak: 3,
+  longestStreak: 5,
+  averageMood: 4.1,
+  averageEnergy: 3.8,
+  averageAccuracy: 4.2,
+  moodDistribution: { "1": 0, "2": 1, "3": 2, "4": 3, "5": 1 },
+  accuracyDistribution: {},
+  tagFrequency: { фокус: 4 },
+}
+
+function emptyMetrics() {
+  return { ...metrics, totalCheckins: 0 }
+}
+
+// START_BLOCK: CHECKIN_STATISTICS_TESTS
+describe("CheckinStatistics", () => {
+  beforeEach(() => {
+    mockFormatDateInTimeZone.mockReset()
+    mockFormatDateInTimeZone.mockReturnValue("2026-07-31")
+    mockGetCheckinMetrics.mockReset()
+    mockLogEvent.mockReset()
+  })
+
+  it("emits one aggregate event on a successful non-empty load and keeps rendered content", async () => {
+    mockGetCheckinMetrics.mockResolvedValue(metrics)
+
+    render(<CheckinStatistics timeZone="Europe/Moscow" />)
+
+    await waitFor(() => {
+      expect(screen.getByTestId("profile-checkin-statistics")).toBeDefined()
+    })
+
+    expect(mockLogEvent).toHaveBeenCalledTimes(1)
+    expect(mockLogEvent).toHaveBeenCalledWith(
+      "checkin.metrics_viewed",
+      { total_checkins: 7, range_days: 30 },
+      {
+        slice: "SLICE-PROFILE-ONBOARDING",
+        module: "M-COMPONENTS-CHECKIN-STATISTICS",
+        block: "CHECKIN_STATISTICS_COMPONENT",
+      },
+    )
+    expect(screen.getByText("Статистика оценок")).toBeDefined()
+    expect(screen.getByText("Всего оценок")).toBeDefined()
+    expect(screen.getAllByText("7").length).toBeGreaterThan(0)
+    expect(screen.getByText("Частые теги")).toBeDefined()
+  })
+
+  it("does not emit the event when the metrics request fails", async () => {
+    mockGetCheckinMetrics.mockRejectedValue(new Error("network down"))
+
+    render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(screen.getByRole("alert")).toBeDefined()
+    })
+
+    expect(mockLogEvent).not.toHaveBeenCalled()
+  })
+
+  it("does not emit the event for empty metrics", async () => {
+    mockGetCheckinMetrics.mockResolvedValue(emptyMetrics())
+
+    render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(screen.queryByRole("status")).toBeNull()
+    })
+
+    expect(screen.queryByTestId("profile-checkin-statistics")).toBeNull()
+    expect(mockLogEvent).not.toHaveBeenCalled()
+  })
+})
+// END_BLOCK: CHECKIN_STATISTICS_TESTS
