+// @vitest-environment jsdom
+// ############################################################################
+// AI_HEADER: MODULE_TESTS_CHECKIN_STATISTICS
+// ROLE: Unit tests for CheckinStatistics rendering and checkin.metrics_viewed emission.
+// DEPENDENCIES: vitest, @testing-library/react, components/profile/checkin-statistics
+// GRACE_ANCHORS: [CHECKIN_STATISTICS_TESTS]
+// SLICE: SLICE-PROFILE-ONBOARDING
+// ############################################################################
+
+// START_MODULE_CONTRACT: M-TESTS-CHECKIN-STATISTICS
+// purpose: Verify CheckinStatistics rendering contract and the checkin.metrics_viewed
+//   business event emission rules (exactly once per successful non-empty load, never on
+//   loading/error/empty, exact payload, existing rendered content preserved).
+// owns:
+//   - __tests__/components/CheckinStatistics.test.tsx
+// inputs: mock lib/api/checkin and lib/log
+// outputs: Vitest assertion results
+// dependencies:
+//   - M-COMPONENTS-CHECKIN-STATISTICS
+// side_effects: renders React components in jsdom environment
+// failure_policy: raise assertions
+// END_MODULE_CONTRACT: M-TESTS-CHECKIN-STATISTICS
+
+// START_MODULE_MAP: M-TESTS-CHECKIN-STATISTICS
+// public_entrypoints:
+//   - none (test suite)
+// semantic_blocks:
+//   - EMISSION_TESTS: event emitted once with exact payload on successful non-empty load
+//   - NEGATIVE_TESTS: no emission on error or empty metrics
+//   - RENDER_TESTS: existing rendered content still present
+// owned_tests:
+//   - __tests__/components/CheckinStatistics.test.tsx
+// END_MODULE_MAP: M-TESTS-CHECKIN-STATISTICS
+
+import { render, screen, waitFor } from "@testing-library/react"
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest"
+
+const { mockGetCheckinMetrics, mockLogEvent } = vi.hoisted(() => ({
+  mockGetCheckinMetrics: vi.fn(),
+  mockLogEvent: vi.fn(),
+}))
+
+vi.mock("@/lib/api/checkin", () => ({
+  getCheckinMetrics: (...args: unknown[]) => mockGetCheckinMetrics(...args),
+  formatDateInTimeZone: () => "2026-07-31",
+}))
+
+vi.mock("@/lib/log", () => ({
+  logEvent: (...args: unknown[]) => mockLogEvent(...args),
+}))
+
+import { CheckinStatistics } from "@/components/profile/checkin-statistics"
+
+function makeMetrics(totalCheckins: number) {
+  return {
+    totalCheckins,
+    currentStreak: 3,
+    longestStreak: 10,
+    averageMood: 3.5,
+    averageEnergy: 3.2,
+    averageAccuracy: 2.8,
+    moodDistribution: { "3": 2, "4": 1 },
+    accuracyDistribution: {},
+    tagFrequency: { Спокойствие: 2 },
+  }
+}
+
+describe("CheckinStatistics", () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+  })
+
+  afterEach(() => {
+    vi.resetModules()
+  })
+
+  it("renders statistics and emits checkin.metrics_viewed exactly once on successful load", async () => {
+    mockGetCheckinMetrics.mockResolvedValue(makeMetrics(12))
+
+    render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(screen.getByTestId("profile-checkin-statistics")).toBeDefined()
+    })
+    expect(screen.getByText("Статистика оценок")).toBeDefined()
+    expect(screen.getByText("Текущая серия")).toBeDefined()
+    expect(screen.getByText("Всего оценок")).toBeDefined()
+
+    expect(mockLogEvent).toHaveBeenCalledTimes(1)
+    expect(mockLogEvent).toHaveBeenCalledWith(
+      "checkin.metrics_viewed",
+      { total_checkins: 12, range_days: 30 },
+      {
+        slice: "SLICE-PROFILE-ONBOARDING",
+        module: "M-COMPONENTS-CHECKIN-STATISTICS",
+        block: "CHECKIN_STATISTICS_COMPONENT",
+      },
+    )
+  })
+
+  it("does not emit when the metrics fetch fails", async () => {
+    mockGetCheckinMetrics.mockRejectedValue(new Error("boom"))
+
+    render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(screen.getByRole("alert")).toBeDefined()
+    })
+    expect(screen.getByText(/Статистика оценок недоступна/)).toBeDefined()
+    expect(mockLogEvent).not.toHaveBeenCalled()
+  })
+
+  it("does not emit when metrics are empty (totalCheckins === 0)", async () => {
+    mockGetCheckinMetrics.mockResolvedValue(makeMetrics(0))
+
+    const { container } = render(<CheckinStatistics />)
+
+    await waitFor(() => {
+      expect(mockGetCheckinMetrics).toHaveBeenCalledTimes(1)
+    })
+    expect(container.querySelector('[data-testid="profile-checkin-statistics"]')).toBeNull()
+    expect(mockLogEvent).not.toHaveBeenCalled()
+  })
+})
