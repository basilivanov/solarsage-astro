{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "deny",
      "npx tsc*": "allow",
      "npx vitest*": "allow",
      "python -m pytest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "rm *": "deny"
    },
    "external_directory": "deny"
  }
}
