        "icon_name": null,
        "blocks": [
          {
            "kind": "paragraph",
            "text": "Сегодня встреча Нептуна с Сатурном создает напряжение (орб 0.3°, сила 0.96), а оппозиция Луны к Плутону (орб 1.0°, сила 0.87) добавляет сложности в эмоциональных вопросах. Также квадрат Меркурия к Плутону (орб 1.3°, сила 0.82) усложняет ситуацию."
          }
        ],
        "layer": "amplifiers",
