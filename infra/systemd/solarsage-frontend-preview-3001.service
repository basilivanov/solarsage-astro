[Unit]
Description=SolarSage Astro Frontend Real-Data Preview (port 3001)
After=network.target solarsage-api.service
Wants=solarsage-api.service

[Service]
Type=simple
User=astro
Group=astro
WorkingDirectory=/opt/solarsage-astro-real-data-preview
Environment=HOME=/home/astro
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStartPre=/usr/bin/npm run build
ExecStart=/usr/bin/node ./node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3001
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStartSec=180
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
