# GRACE frontend enforcement whitelist (W-2.0).
# Single source of truth for both ESLint (eslint.config.mjs) and the bash marker
# gate (scripts/grace/check-markers.sh). Lines starting with "#" are ignored.
# Format: one glob per line, relative to repo root, POSIX style.
#
# Rationale: whitelist, not blacklist. New caller directories are inert until
# explicitly added here, so silent scope creep cannot bypass GRACE markers.

app/(grace)/**/*.tsx
app/(grace)/**/*.ts
components/grace/**/*.tsx
components/grace/**/*.ts
components/promo/**/*.tsx
components/promo/**/*.ts
components/checkin/**/*.tsx
components/checkin/**/*.ts
components/chat/**/*.tsx
components/chat/**/*.ts
components/calendar/**/*.tsx
components/calendar/**/*.ts
components/onboarding/**/*.tsx
components/onboarding/**/*.ts
components/profile/**/*.tsx
components/profile/**/*.ts
components/readings/*.tsx
components/readings/*.ts
components/readings/election/**/*.tsx
components/readings/election/**/*.ts
lib/grace/**/*.ts
lib/api/**/*.ts
lib/api/promo.ts
packages/contracts/index.ts
