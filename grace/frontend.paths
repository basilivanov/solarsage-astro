# GRACE frontend enforcement whitelist (W-2.0).
# Single source of truth for both ESLint (eslint.config.mjs) and the bash marker
# gate (scripts/grace/check-markers.sh). Lines starting with "#" are ignored.
# Format: one glob per line, relative to repo root, POSIX style.
#
# Rationale: whitelist, not blacklist. New caller directories are inert until
# explicitly added here, so silent scope creep cannot bypass GRACE markers.

app/(grace)/**/*.tsx
app/(grace)/**/*.ts
components/grace/**/*.tsx
components/grace/**/*.ts
components/promo/**/*.tsx
components/promo/**/*.ts
components/checkin/**/*.tsx
components/checkin/**/*.ts
components/chat/**/*.tsx
components/chat/**/*.ts
components/calendar/**/*.tsx
components/calendar/**/*.ts
components/onboarding/**/*.tsx
components/onboarding/**/*.ts
components/profile/**/*.tsx
components/profile/**/*.ts
components/readings/*.tsx
components/readings/*.ts
components/readings/election/**/*.tsx
components/readings/election/**/*.ts
components/readings/horary/**/*.tsx
components/readings/horary/**/*.ts
components/readings/natal/**/*.tsx
components/readings/natal/**/*.ts
components/readings/natal-preview/**/*.tsx
components/readings/natal-preview/**/*.ts
components/today/**/*.tsx
components/today/**/*.ts
components/correlation-init.tsx
components/debug-button.tsx
components/locked-feature-card.tsx
components/paywall.tsx
components/profile-reset.tsx
components/reset-button.tsx
components/telegram-init.tsx
components/telegram-provider.tsx
components/theme-provider.tsx
components/today-important-accordion.tsx
components/today-important-block.tsx
components/trial-banner.tsx
hooks/**/*.ts
components/shared/**/*.tsx
components/shared/**/*.ts
components/monetization/**/*.tsx
components/monetization/**/*.ts
components/synastry/**/*.tsx
components/synastry/**/*.ts
lib/grace/**/*.ts
lib/api/**/*.ts
lib/api/promo.ts
packages/contracts/index.ts
